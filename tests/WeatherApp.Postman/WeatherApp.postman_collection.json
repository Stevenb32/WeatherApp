              "    {",
              "      date: \"2026-08-21\",",
              "      minimumTemperature: 25,",
              "      maximumTemperature: 33,",
              "      condition: \"Partly cloudy\",",
              "      precipitationChance: 40",
              "    },",
              "    {",
              "      date: \"2026-08-22\",",
              "      minimumTemperature: 25,",
              "      maximumTemperature: 33,",
              "      condition: \"Partly cloudy\",",
              "      precipitationChance: 40",
              "    }",
              "  ]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
