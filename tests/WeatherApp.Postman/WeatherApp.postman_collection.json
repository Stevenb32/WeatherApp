    {
      "name": "Weather — missing location",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Response uses the Problem Details JSON media type\", function () {",
              "  pm.response.to.be.json;",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/problem\\+json(?:;|$)/i);",
              "});",
              "",
              "const responseBody = pm.response.text();",
              "const responseJson = pm.response.json();",
              "",
              "pm.test(\"Problem details describe the missing location\", function () {",
              "  pm.expect(responseJson.title).to.eql(\"Invalid location\");",
              "  pm.expect(responseJson.status).to.eql(400);",
              "  pm.expect(responseJson.detail).to.eql(\"A location must be provided.\");",
              "});",
              "",
              "pm.test(\"Response does not expose provider details or credentials\", function () {",
              "  for (const propertyName of [\"error\", \"providerError\", \"providerResponse\", \"apiKey\"]) {",
              "    pm.expect(responseJson).not.to.have.property(propertyName);",
              "  }",
              "",
              "  for (const forbiddenText of [",
              "    \"No matching location found.\",",
              "    \"Deterministic provider failure.\",",
              "    \"WeatherAPI request failed\",",
              "    \"weatherapp-e2e-placeholder\"",
              "  ]) {",
              "    pm.expect(responseBody).not.to.include(forbiddenText);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/weather",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "weather"
          ]
        },
        "description": "Omits the required location query value."
      },
      "response": []
    },
