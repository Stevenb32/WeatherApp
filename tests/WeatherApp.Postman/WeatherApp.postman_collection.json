    {
      "name": "Weather — default imperial",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const weatherResponseSchema = {",
              "  type: \"object\",",
              "  additionalProperties: false,",
              "  required: [\"location\", \"unitSystem\", \"current\", \"hourly\", \"daily\"],",
              "  properties: {",
              "    location: {",
              "      type: \"object\",",
              "      additionalProperties: false,",
              "      required: [\"name\", \"region\", \"country\", \"timeZoneId\"],",
              "      properties: {",
              "        name: { type: \"string\" },",
              "        region: { type: \"string\" },",
              "        country: { type: \"string\" },",
              "        timeZoneId: { type: \"string\" }",
              "      }",
              "    },",
              "    unitSystem: { type: \"string\", enum: [\"imperial\", \"metric\"] },",
              "    current: {",
              "      type: \"object\",",
              "      additionalProperties: false,",
              "      required: [\"temperature\", \"condition\", \"humidity\", \"windSpeed\", \"windDirection\"],",
              "      properties: {",
              "        temperature: { type: \"number\" },",
              "        condition: { type: \"string\" },",
              "        humidity: { type: \"integer\" },",
              "        windSpeed: { type: \"number\" },",
              "        windDirection: { type: \"string\" }",
              "      }",
              "    },",
              "    hourly: {",
              "      type: \"array\",",
              "      minItems: 24,",
              "      maxItems: 24,",
              "      items: {",
              "        type: \"object\",",
              "        additionalProperties: false,",
              "        required: [\"time\", \"temperature\", \"condition\", \"precipitationChance\"],",
              "        properties: {",
              "          time: { type: \"string\", format: \"date-time\" },",
              "          temperature: { type: \"number\" },",
              "          condition: { type: \"string\" },",
              "          precipitationChance: { type: \"integer\" }",
              "        }",
              "      }",
              "    },",
              "    daily: {",
              "      type: \"array\",",
              "      minItems: 3,",
              "      maxItems: 3,",
              "      items: {",
              "        type: \"object\",",
              "        additionalProperties: false,",
              "        required: [\"date\", \"minimumTemperature\", \"maximumTemperature\", \"condition\", \"precipitationChance\"],",
              "        properties: {",
              "          date: { type: \"string\", format: \"date\" },",
              "          minimumTemperature: { type: \"number\" },",
              "          maximumTemperature: { type: \"number\" },",
              "          condition: { type: \"string\" },",
              "          precipitationChance: { type: \"integer\" }",
              "        }",
              "      }",
              "    }",
              "  }",
              "};",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has JSON content\", function () {",
              "  pm.response.to.be.json;",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/json(?:;|$)/i);",
              "});",
              "",
              "const responseJson = pm.response.json();",
              "",
              "pm.test(\"Response matches the complete public weather contract\", function () {",
              "  pm.response.to.have.jsonSchema(weatherResponseSchema);",
              "});",
              "",
              "pm.test(\"Omitted units default to imperial\", function () {",
              "  pm.expect(responseJson.unitSystem).to.eql(\"imperial\");",
              "});",
              "",
              "pm.test(\"Location and current conditions match the deterministic fixture\", function () {",
              "  pm.expect(responseJson.location).to.eql({",
              "    name: \"Tampa\",",
              "    region: \"Florida\",",
              "    country: \"United States of America\",",
              "    timeZoneId: \"America/New_York\"",
              "  });",
              "  pm.expect(responseJson.current).to.eql({",
              "    temperature: 87.8,",
              "    condition: \"Partly cloudy\",",
              "    humidity: 70,",
              "    windSpeed: 8.1,",
              "    windDirection: \"E\"",
              "  });",
              "});",
              "",
              "pm.test(\"Forecast contains exactly 24 hourly and three daily entries\", function () {",
              "  pm.expect(responseJson.hourly).to.have.lengthOf(24);",
              "  pm.expect(responseJson.daily).to.have.lengthOf(3);",
              "});",
              "",
              "pm.test(\"Representative hourly entries match the deterministic fixture\", function () {",
              "  const representativeHours = [",
              "    {",
              "      index: 0,",
              "      expected: {",
              "        time: \"2026-08-21T01:00:00+00:00\",",
              "        temperature: 80.6,",
              "        condition: \"Sunny\",",
              "        precipitationChance: 10",
              "      }",
              "    },",
              "    {",
              "      index: 12,",
              "      expected: {",
              "        time: \"2026-08-21T13:00:00+00:00\",",
              "        temperature: 80.6,",
              "        condition: \"Sunny\",",
              "        precipitationChance: 10",
              "      }",
              "    },",
              "    {",
              "      index: 23,",
              "      expected: {",
              "        time: \"2026-08-22T00:00:00+00:00\",",
              "        temperature: 80.6,",
              "        condition: \"Sunny\",",
              "        precipitationChance: 10",
              "      }",
              "    }",
              "  ];",
              "",
              "  for (const entry of representativeHours) {",
              "    pm.expect(responseJson.hourly[entry.index], \"hourly[\" + entry.index + \"]\").to.eql(entry.expected);",
              "  }",
              "});",
              "",
              "pm.test(\"Daily forecast matches the deterministic fixture\", function () {",
              "  pm.expect(responseJson.daily).to.eql([",
              "    {",
              "      date: \"2026-08-20\",",
              "      minimumTemperature: 77,",
              "      maximumTemperature: 91.4,",
              "      condition: \"Partly cloudy\",",
              "      precipitationChance: 40",
              "    },",
              "    {",
              "      date: \"2026-08-21\",",
              "      minimumTemperature: 77,",
              "      maximumTemperature: 91.4,",
              "      condition: \"Partly cloudy\",",
              "      precipitationChance: 40",
              "    },",
              "    {",
              "      date: \"2026-08-22\",",
              "      minimumTemperature: 77,",
              "      maximumTemperature: 91.4,",
              "      condition: \"Partly cloudy\",",
              "      precipitationChance: 40",
              "    }",
              "  ]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/weather?location={{tampaLocation}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "weather"
          ],
          "query": [
            {
              "key": "location",
              "value": "{{tampaLocation}}"
            }
          ]
        },
        "description": "Requests the deterministic Tampa forecast using the public default unit system."
      },
      "response": []
    },
